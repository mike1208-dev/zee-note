# Copy this file to .env and fill in your values. Never commit .env.

# Groq: create a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Models shown in the app's dropdown (comma-separated)
GROQ_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b,openai/gpt-oss-120b

# Model that runs inside the app (optional). To test hosting with the untrained model:
# LOCAL_MODEL_REPO=Qwen/Qwen2.5-0.5B-Instruct-GGUF and LOCAL_MODEL_FILE=qwen2.5-0.5b-instruct-q8_0.gguf
# For the trained model, use its repository and file, a new label, and HF_TOKEN if the repository is private.
LOCAL_MODEL_REPO=
LOCAL_MODEL_FILE=
LOCAL_MODEL_LABEL=
HF_TOKEN=
# Or a model file on this computer instead of LOCAL_MODEL_REPO and LOCAL_MODEL_FILE
LOCAL_MODEL_PATH=
# Processor threads for this model (default: up to 4)
LOCAL_MODEL_THREADS=

# Rule database (optional). Without these, rules come from rules/*.yaml and can't be edited in the app.
# Supabase: Project Settings -> Data API (URL) and API Keys -> Secret keys (key)
SUPABASE_URL=
SUPABASE_KEY=
# Password for the "Manage rules" page
EDITOR_PASSWORD=

# Web app v1: the password of every sample account (zeenote if empty). Set a long one before sharing the app with a link
ZEENOTE_PASSWORD=
